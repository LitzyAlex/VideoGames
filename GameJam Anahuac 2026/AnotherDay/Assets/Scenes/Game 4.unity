  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MotivacionManager
  textoMotivacion: {fileID: 2077304625}
  frases:
  - "\xBFCansado? Recuerda que tu puesto tambi\xE9n est\xE1 cansado de ti."
  - "La productividad es felicidad. Si no eres feliz, trabaja m\xE1s."
  - "El estr\xE9s demuestra que est\xE1s dando el 110%."
  - "No est\xE1s agotado. Est\xE1s alcanzando tu m\xE1ximo potencial."
  - "Si puedes leer esto, todav\xEDa puedes trabajar."
  - El que es bueno es bueno.
  - "Aqu\xED el tiempo extra es voluntariamente obligado"
  velocidadEscritura: 0.04
