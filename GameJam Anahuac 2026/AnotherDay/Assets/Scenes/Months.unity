  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 203689487}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd26ca8d338686547bc41fdf1a64b2f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TransicionMes
  textoMes: {fileID: 660697921}
  numeroMes: {fileID: 1519600415}
  textoFrase: {fileID: 838709196}
  meses:
  - numero: 01
    frase: "\xA1Bienvenido! Recuerda: una actitud positiva puede hacer que ocho horas
      de trabajo se sientan como doce."
    escena: Game
  - numero: 02
    frase: "Tu esfuerzo es muy importante para nosotros. Por eso esperamos que puedas
      dar un poco m\xE1s de ti cada d\xEDa."
    escena: Game 1
  - numero: 03
    frase: "Un buen empleado sabe cu\xE1ndo descansar. Afortunadamente, nosotros
      decidimos cu\xE1ndo.  "
    escena: Game 2
  - numero: 04
    frase: "\xA1Gran esfuerzo! Recuerda que eres una pieza fundamental de esta empresa.
      Y las piezas fundamentales no pueden darse el lujo de detenerse."
    escena: Game 3
  - numero: 05
    frase: "\xA1Felicidades! Has demostrado un compromiso excepcional. Recuerda:
      mientras sigas trabajando, no tendr\xE1s tiempo para pensar en lo cansado que
      est\xE1s."
    escena: Game 4
  tiempoEntreElementos: 1
  velocidadFrase: 0.04
  fadeOut: {fileID: 2041648478}
  tiempoAntesDelFade: 2
